generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  permissions Json
  isSystem    Boolean      @default(false)
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users User[]
}

enum CommonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DataLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum ImportTaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ScanTaskStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

enum ClassificationTaskStatus {
  WAITING_IMPORT
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ClassificationTaskSource {
  CLASSIFICATION_CENTER
  ASSET_IMPORT
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ProtectionFeatureType {
  MASKING
  ENCRYPTION
}

enum ProtectionFeatureStatus {
  ACTIVE
  INACTIVE
}

enum AuditLogCategory {
  AUTH
  ASSET_GROUP
  IMPORT_TASK
  CLASSIFICATION_TASK
  AUTO_SCAN
  TEMPLATE
  PROTECTION_FEATURE
  USER_MANAGEMENT
  ROLE_MANAGEMENT
}

enum AuditLogResult {
  SUCCESS
  FAILED
  RUNNING
  INFO
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  name         String
  avatar       String?
  email        String?      @unique
  phone        String?      @unique
  roleId       String?
  title        String?
  department   String?
  signature    String?
  status       CommonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  role                Role?                @relation(fields: [roleId], references: [id])
  importTasks         ImportTask[]
  classificationTasks ClassificationTask[]
  protectionFeatures  ProtectionFeature[]

  @@index([roleId])
}

model AssetGroup {
  id          String       @id @default(cuid())
  name        String
  description String?
  parentId    String?
  level       Int          @default(1)
  owner       String?
  department  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent      AssetGroup?      @relation("AssetGroupTree", fields: [parentId], references: [id])
  children    AssetGroup[]     @relation("AssetGroupTree")
  dataAssets  DataAsset[]
  importTasks ImportTask[]
  scanRules   AutoScanRule[]
  scanResults AutoScanResult[]

  @@index([parentId])
}

model AssetGroupDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataAsset {
  id           String       @id @default(cuid())
  name         String
  sourceType   String
  ipAddress    String
  port         Int
  status       CommonStatus @default(ACTIVE)
  dataLevel    DataLevel
  owner        String
  department   String
  tags         Json?
  description  String?
  tableCount   Int          @default(0)
  fieldCount   Int          @default(0)
  sizeBytes    Int          @default(0)
  recordCount  Int          @default(0)
  isDeleted    Boolean      @default(false)
  deletedAt    DateTime?
  assetGroupId String
  scanResultId String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assetGroup  AssetGroup       @relation(fields: [assetGroupId], references: [id])
  scanResult  AutoScanResult?  @relation(fields: [scanResultId], references: [id])
  tables      DataAssetTable[]
  importTasks ImportTask[]

  @@index([assetGroupId])
}

model ImportTask {
  id                   String           @id @default(cuid())
  sourceName           String
  sourceType           String
  ipAddress            String
  port                 Int
  databaseName         String?
  databaseNames        Json?            @default("[]")
  sourceUsername       String?
  sourcePassword       String?
  assetGroupId         String
  dataAssetId          String?
  classificationTaskId String?
  creatorId            String?
  scheduleMode         String           @default("single")
  executeAt            DateTime?
  sampleCount          Int              @default(20)
  sampleStrategy       String           @default("latest")
  sampleStorageMode    String           @default("replace")
  status               ImportTaskStatus @default(PENDING)
  progress             Int              @default(0)
  importedTableCount   Int              @default(0)
  importedFieldCount   Int              @default(0)
  importedRecordCount  Int              @default(0)
  runClassificationImmediatelyAfterImport Boolean @default(false)
  classificationTriggeredAt DateTime?
  errorMessage         String?
  description          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  assetGroup         AssetGroup          @relation(fields: [assetGroupId], references: [id])
  dataAsset          DataAsset?          @relation(fields: [dataAssetId], references: [id])
  classificationTask ClassificationTask? @relation(fields: [classificationTaskId], references: [id])
  creator            User?               @relation(fields: [creatorId], references: [id])
  tables             DataAssetTable[]

  @@index([assetGroupId])
  @@index([dataAssetId])
  @@index([classificationTaskId])
  @@index([creatorId])
}

model DataAssetTable {
  id           String   @id @default(cuid())
  assetId      String
  importTaskId String?
  databaseName String   @default("")
  tableName    String
  tableComment String?
  engine       String?
  rowCount     Int      @default(0)
  sizeBytes    Int      @default(0)
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset      DataAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  importTask ImportTask?       @relation(fields: [importTaskId], references: [id], onDelete: SetNull)
  columns    DataAssetColumn[]

  @@unique([assetId, databaseName, tableName])
  @@index([assetId])
  @@index([importTaskId])
}

model DataAssetColumn {
  id                       String     @id @default(cuid())
  tableId                  String
  columnName               String
  columnComment            String?
  dataType                 String
  columnType               String
  isNullable               Boolean    @default(true)
  isPrimaryKey             Boolean    @default(false)
  ordinalPosition          Int
  sampleData               Json?
  classificationDataTypeId String?
  dataCategory             String?
  dataLevel                DataLevel?
  isSensitive              Boolean    @default(false)
  needMask                 Boolean    @default(false)
  needEncrypt              Boolean    @default(false)
  isDeleted                Boolean    @default(false)
  deletedAt                DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  table                  DataAssetTable          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  classificationDataType ClassificationDataType? @relation(fields: [classificationDataTypeId], references: [id], onDelete: SetNull)

  @@unique([tableId, columnName])
  @@index([tableId])
  @@index([classificationDataTypeId])
}

model AutoScanRule {
  id             String         @id @default(cuid())
  name           String
  cronExpression String?
  assetGroupId   String?
  sourceType     String?
  status         ScanTaskStatus @default(DRAFT)
  description    String?
  lastScannedAt  DateTime?
  scanProgress   Int?
  scanStatus     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assetGroup AssetGroup?      @relation(fields: [assetGroupId], references: [id])
  results    AutoScanResult[]

  @@index([assetGroupId])
}

model AutoScanResult {
  id           String         @id @default(cuid())
  scanRuleId   String?
  assetGroupId String?
  sourceName   String
  sourceType   String
  ipAddress    String
  port         Int
  databaseName String?
  owner        String?
  department   String?
  status       ScanTaskStatus @default(COMPLETED)
  claimed      Boolean        @default(false)
  ignoreReason String?
  ignoredAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  scanRule   AutoScanRule? @relation(fields: [scanRuleId], references: [id])
  assetGroup AssetGroup?   @relation(fields: [assetGroupId], references: [id])
  dataAsset  DataAsset?

  @@index([scanRuleId])
  @@index([assetGroupId])
}

model ClassificationTemplate {
  id           String         @id @default(cuid())
  templateName String
  templateType String?
  description  String?
  status       TemplateStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  categories       ClassificationCategory[]
  levelDefinitions ClassificationLevelDefinition[]
  dataTypes        ClassificationDataType[]
  tasks            ClassificationTask[]
}

model ClassificationCategory {
  id          String   @id @default(cuid())
  templateId  String
  parentId    String?
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template  ClassificationTemplate   @relation(fields: [templateId], references: [id])
  parent    ClassificationCategory?  @relation("ClassificationCategoryTree", fields: [parentId], references: [id])
  children  ClassificationCategory[] @relation("ClassificationCategoryTree")
  dataTypes ClassificationDataType[]

  @@index([templateId])
  @@index([parentId])
}

model ClassificationLevelDefinition {
  id          String   @id @default(cuid())
  templateId  String
  code        String
  name        String
  color       String?
  description String?
  isSensitive Boolean  @default(false)
  needMask    Boolean  @default(false)
  needEncrypt Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template  ClassificationTemplate   @relation(fields: [templateId], references: [id])
  dataTypes ClassificationDataType[]

  @@unique([templateId, code])
  @@index([templateId])
}

model ClassificationDataType {
  id                String   @id @default(cuid())
  templateId        String
  categoryId        String
  levelDefinitionId String?
  name              String
  isSensitive       Boolean  @default(false)
  needMask          Boolean  @default(false)
  needEncrypt       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  template        ClassificationTemplate         @relation(fields: [templateId], references: [id])
  category        ClassificationCategory         @relation(fields: [categoryId], references: [id])
  levelDefinition ClassificationLevelDefinition? @relation(fields: [levelDefinitionId], references: [id])
  rules           ClassificationRule[]
  importedColumns DataAssetColumn[]

  @@index([templateId])
  @@index([categoryId])
  @@index([levelDefinitionId])
}

model ClassificationRule {
  id         String   @id @default(cuid())
  dataTypeId String
  target     String
  matcher    String
  value      String
  hitRate    Decimal  @db.Decimal(5, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dataType ClassificationDataType @relation(fields: [dataTypeId], references: [id])

  @@index([dataTypeId])
}

model ClassificationTask {
  id                 String                   @id @default(cuid())
  taskName           String
  dataSource         String
  dataAssetIds       Json?
  dataType           String
  scheduleMode       String                   @default("single")
  classificationType String
  priority           String
  description        String?
  source             ClassificationTaskSource @default(CLASSIFICATION_CENTER)
  sourceLabel        String?
  status             ClassificationTaskStatus @default(PENDING)
  templateId         String?
  creatorId          String?
  executeAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  template    ClassificationTemplate? @relation(fields: [templateId], references: [id])
  creator     User?                   @relation(fields: [creatorId], references: [id])
  importTasks ImportTask[]

  @@index([templateId])
  @@index([creatorId])
}

model ProtectionFeature {
  id           String                  @id @default(cuid())
  featureType  ProtectionFeatureType
  featureName  String
  featureCode  String?
  scene        String?
  featurePoint String
  matcher      String
  hitRate      Int                     @map("confidence")
  priority     Int?
  expression   String
  sampleValue  String
  status       ProtectionFeatureStatus @default(ACTIVE)
  description  String?
  creatorId    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  creator User? @relation(fields: [creatorId], references: [id])

  @@index([featureType])
  @@index([creatorId])
}

model AppBootstrapState {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String           @id @default(cuid())
  category   AuditLogCategory
  action     String
  result     AuditLogResult   @default(INFO)
  actorId    String?
  actorName  String?
  targetType String?
  targetId   String?
  targetName String?
  detail     String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([category])
  @@index([result])
  @@index([createdAt])
}
